---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection";
import PracticeModal from "../components/PracticeModal";
import RoundExplorer from "../components/RoundExplorer";
import { rounds } from "../data/rounds";
import { lps } from "../data/lps";
import "../styles/global.css";

const lpNames = lps.map(l => l.name);
---

<BaseLayout>
  <!-- ═══ NAV ═══════════════════════════════════════════════════ -->
  <nav id="nav" style="position:fixed;top:0;left:0;right:0;z-index:200;padding:0 64px;height:64px;display:flex;align-items:center;justify-content:space-between;background:rgba(6,6,10,0);border-bottom:1px solid rgba(255,255,255,0);transition:background 0.4s,border-color 0.4s;">
    <a href="#" style="font-family:var(--font-heading);font-weight:800;font-size:15px;color:#eeeef8;text-decoration:none;display:flex;align-items:center;gap:8px;letter-spacing:-0.02em;">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><polygon points="9,1 16,5 16,13 9,17 2,13 2,5" stroke="#FF9900" stroke-width="1.2" fill="rgba(255,153,0,0.08)"/></svg>
      TPM<span style="color:#FF9900">·</span>Prep
    </a>
    <div style="display:flex;align-items:center;gap:2px;">
      {["rounds","principles","design","resources"].map(s => (
        <a href={`#${s}`} style="font-size:12px;color:rgba(238,238,248,0.45);text-decoration:none;padding:7px 14px;border-radius:8px;font-family:var(--font-heading);font-weight:500;letter-spacing:0.01em;transition:color 0.2s,background 0.2s;" onmouseover="this.style.color='#eeeef8';this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.color='rgba(238,238,248,0.45)';this.style.background='none'">{s.charAt(0).toUpperCase()+s.slice(1)}</a>
      ))}
    </div>
  </nav>

  <!-- ═══ HERO ══════════════════════════════════════════════════ -->
  <div id="hero">
    <HeroSection client:only="react" />
  </div>

  <!-- ═══ MARQUEE ═══════════════════════════════════════════════ -->
  <div style="position:relative;z-index:1;padding:20px 0;border-top:1px solid rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.05);background:rgba(6,6,10,0.5);">
    <div class="marquee-outer" style="margin-bottom:10px;">
      <div class="marquee-track">
        {[...lpNames,...lpNames,...lpNames].map((n,i) => (
          <span class="marquee-item"><span class="dot"></span>{n}</span>
        ))}
      </div>
    </div>
    <div class="marquee-outer">
      <div class="marquee-track rtl">
        {[...lpNames,...lpNames,...lpNames].reverse().map((n,i) => (
          <span class="marquee-item" style="color:rgba(238,238,248,0.15);"><span class="dot" style="background:rgba(129,140,248,0.4);"></span>{n}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ ROUNDS BENTO ══════════════════════════════════════════ -->
  <section id="rounds" style="position:relative;z-index:1;padding:100px 64px;max-width:1280px;margin:0 auto;" class="reveal">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;flex-wrap:wrap;gap:20px;">
      <div>
        <span class="section-tag">The Loop</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(36px,5vw,60px);font-weight:900;letter-spacing:-0.035em;margin-top:16px;line-height:1.0;">Six rounds.<br/><span class="gradient-text">Zero surprises.</span></h2>
      </div>
      <p style="color:rgba(238,238,248,0.35);font-size:14px;max-width:320px;line-height:1.7;text-align:right;">Every dimension of the Amazon TPM loop — behavioral, technical, strategic, cultural — with guided questions and coaching hints.</p>
    </div>

    <div class="bento-grid">
      {rounds.map((round, i) => (
        <a href="#round-explorer" class={`tilt-card bento-r${i+1}`}
          style={`display:block;text-decoration:none;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.07);background:radial-gradient(ellipse 120% 80% at 0% 0%,${round.bgGlow},transparent),#0c0c14;padding:${i===0?'40px':'28px'} 28px;transition:border-color 0.25s;position:relative;`}
          onmouseover={`this.style.borderColor='${round.color}44'`}
          onmouseout={`this.style.borderColor='rgba(255,255,255,0.07)'`}
          data-round-index={i}
          data-tilt>
          <!-- Shimmer line top -->
          <div style={`position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,${round.color}44,transparent);`}></div>

          <div class="inner">
            <div style={`font-size:${i===0?'40px':'28px'};margin-bottom:${i===0?'20px':'12px'};`}>{round.icon}</div>
            <div style={`font-family:var(--font-heading);font-weight:800;font-size:${i===0?'22px':'16px'};color:${round.color};margin-bottom:8px;letter-spacing:-0.01em;`}>{round.name}</div>
            <p style={`font-size:13px;color:rgba(238,238,248,0.4);line-height:1.65;${i===0?'':'display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;'}`}>{round.description}</p>
            <div style={`margin-top:${i===0?'28px':'16px'};display:flex;align-items:center;gap:8px;`}>
              <span style={`font-size:10px;font-family:var(--font-heading);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:${round.color}88;`}>{round.questions.length} questions</span>
              <span style={`color:${round.color}44;`}>·</span>
              <span style={`font-size:10px;font-family:var(--font-heading);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:${round.color}88;`}>{Math.floor(round.timeLimit/60)}m each</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ DIVIDER ════════════════════════════════════════════════ -->
  <div style="max-width:1280px;margin:0 auto;padding:0 64px;"><div class="divline"></div></div>

  <!-- ═══ ROUND EXPLORER (tabbed) ═══════════════════════════════ -->
  <section style="position:relative;z-index:1;padding:80px 64px;max-width:1280px;margin:0 auto;" class="reveal">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;flex-wrap:wrap;gap:20px;">
      <div>
        <span class="section-tag">Questions</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(28px,3.5vw,44px);font-weight:900;letter-spacing:-0.03em;margin-top:14px;line-height:1.05;">Explore every round.</h2>
      </div>
      <p style="color:rgba(238,238,248,0.35);font-size:13px;max-width:280px;line-height:1.7;text-align:right;">Switch rounds with one click. No scrolling between sections.</p>
    </div>
    <RoundExplorer client:only="react" />
  </section>

  <!-- ═══ DIVIDER ════════════════════════════════════════════════ -->
  <div style="max-width:1280px;margin:0 auto;padding:0 64px;"><div class="divline"></div></div>

  <!-- ═══ LEADERSHIP PRINCIPLES ════════════════════════════════ -->
  <section id="principles" style="position:relative;z-index:1;padding:100px 64px;max-width:1280px;margin:0 auto;" class="reveal">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;flex-wrap:wrap;gap:20px;">
      <div>
        <span class="section-tag">Amazon Culture</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(36px,5vw,60px);font-weight:900;letter-spacing:-0.035em;margin-top:16px;line-height:1.05;">All 16 LPs.<br/><span class="gradient-text">Cold.</span></h2>
      </div>
      <p style="color:rgba(238,238,248,0.35);font-size:14px;max-width:300px;line-height:1.7;text-align:right;">Every behavioral question is an LP in disguise. Know the nuance, not just the name.</p>
    </div>

    <div class="foldable" data-show="6" style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;">
      {lps.map(lp => (
        <details style="background:rgba(255,255,255,0.018);border:1px solid rgba(255,255,255,0.06);border-radius:14px;overflow:hidden;" class="lp-card fold-item">
          <summary style="list-style:none;padding:20px 22px;cursor:none;display:flex;align-items:flex-start;gap:12px;">
            <span style="font-family:var(--font-mono);font-size:10px;color:rgba(255,153,0,0.4);padding-top:4px;flex-shrink:0;min-width:22px;">{String(lp.id).padStart(2,'0')}</span>
            <div style="flex:1;min-width:0;">
              <div style="font-family:var(--font-heading);font-weight:700;font-size:14px;color:#eeeef8;">{lp.name}</div>
              <div style="font-size:12px;color:rgba(238,238,248,0.35);margin-top:2px;font-style:italic;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{lp.tagline}</div>
            </div>
            <svg class="chevron" width="15" height="15" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:4px;transition:transform 0.3s cubic-bezier(0.22,1,0.36,1);color:rgba(255,153,0,0.6);"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div style="padding:4px 22px 22px 56px;border-top:1px solid rgba(255,255,255,0.04);">
            <p style="font-size:13px;color:rgba(238,238,248,0.6);line-height:1.75;margin-bottom:14px;margin-top:14px;">{lp.description}</p>
            <div style="background:rgba(248,113,113,0.05);border:1px solid rgba(248,113,113,0.12);border-radius:10px;padding:11px 14px;margin-bottom:14px;">
              <p style="font-size:12px;color:#f87171;line-height:1.6;"><strong>Watch out: </strong>{lp.watchout}</p>
            </div>
            <p style="font-size:10px;font-family:var(--font-heading);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,153,0,0.55);margin-bottom:10px;">STAR Prompts</p>
            {lp.starPrompts.map(p => (
              <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:7px;">
                <span style="color:rgba(255,153,0,0.5);flex-shrink:0;font-size:10px;margin-top:3px;">▸</span>
                <p style="font-size:13px;color:rgba(238,238,248,0.5);line-height:1.55;">{p}</p>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
    <button class="fold-toggle" style="margin-top:16px;background:none;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:10px 18px;color:rgba(238,238,248,0.4);font-family:var(--font-heading);font-size:12px;font-weight:600;letter-spacing:0.04em;cursor:none;transition:color 0.2s,border-color 0.2s;" onmouseover="this.style.color='#eeeef8';this.style.borderColor='rgba(255,255,255,0.18)'" onmouseout="this.style.color='rgba(238,238,248,0.4)';this.style.borderColor='rgba(255,255,255,0.08)'"></button>
  </section>

  <!-- ═══ DIVIDER ════════════════════════════════════════════════ -->
  <div style="max-width:1280px;margin:0 auto;padding:0 64px;"><div class="divline"></div></div>

  <!-- ═══ SYSTEM DESIGN ═════════════════════════════════════════ -->
  <section id="design" style="position:relative;z-index:1;padding:100px 64px;max-width:1280px;margin:0 auto;" class="reveal">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;flex-wrap:wrap;gap:20px;">
      <div>
        <span class="section-tag">Technical Depth</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(36px,5vw,60px);font-weight:900;letter-spacing:-0.035em;margin-top:16px;line-height:1.05;">System Design<br/><span class="gradient-text">Playbook.</span></h2>
      </div>
      <p style="color:rgba(238,238,248,0.35);font-size:14px;max-width:300px;line-height:1.7;text-align:right;">The 6-step framework — in your hands before any technical screen.</p>
    </div>

    <!-- Horizontal scroll steps -->
    <div class="h-scroll-outer" style="margin-bottom:40px;">
      <div class="h-scroll-track">
        {[
          {n:"01",t:"Clarify Requirements",d:"Ask 3-5 scoping questions. Functional requirements (what it does) vs non-functional (scale, latency, availability). Never assume.",c:"#FF9900"},
          {n:"02",t:"Capacity Estimation",d:"Back-of-envelope math for req/sec, storage, bandwidth. 10× overestimate is fine. Shows you think at internet scale.",c:"#f87171"},
          {n:"03",t:"API Design",d:"Define core endpoints before touching architecture. Aligns scope and surfaces hidden assumptions before you commit.",c:"#818cf8"},
          {n:"04",t:"High-Level Architecture",d:"Draw the main components: LB, services, DB, cache, CDN. Walk through one complete user flow end-to-end.",c:"#2dd4bf"},
          {n:"05",t:"Component Deep Dive",d:"Pick 2-3 components to go deep. Database schema, cache invalidation, replication strategy, consistency model.",c:"#4ade80"},
          {n:"06",t:"Trade-offs & Bottlenecks",d:"Name every trade-off: SQL vs NoSQL, consistency vs availability, push vs pull. Every decision has a cost — say it.",c:"#fbbf24"},
        ].map(step => (
          <div class="h-scroll-card" style={`border-left:2px solid ${step.c}66;`}>
            <div style={`font-family:var(--font-mono);font-size:10px;color:${step.c};margin-bottom:10px;letter-spacing:0.1em;`}>{step.n}</div>
            <div style={`font-family:var(--font-heading);font-weight:700;font-size:15px;color:${step.c};margin-bottom:10px;`}>{step.t}</div>
            <p style="font-size:13px;color:rgba(238,238,248,0.45);line-height:1.65;">{step.d}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Concepts horizontal scroll -->
    <div class="h-scroll-outer">
      <div class="h-scroll-track">
        {[
          {i:"⚡",l:"CAP Theorem",d:"Pick two: Consistency, Availability, Partition Tolerance. Know your trade-off before the whiteboard.",c:"#FF9900"},
          {i:"🔑",l:"Consistent Hashing",d:"Distribute data with minimal reshuffling when nodes join or leave. Essential for distributed caches.",c:"#f87171"},
          {i:"📦",l:"Event Sourcing",d:"Store state as immutable events. Enables audit, replay, decoupled consumers. Great for order systems.",c:"#818cf8"},
          {i:"🔄",l:"CQRS",d:"Separate read/write models. Optimize each path independently — critical at Amazon's traffic levels.",c:"#2dd4bf"},
          {i:"🛡️",l:"Circuit Breaker",d:"Fail fast when downstream is down. Prevents cascading failure across your microservice graph.",c:"#4ade80"},
          {i:"📊",l:"Rate Limiting",d:"Token bucket, leaky bucket, sliding window — know each algorithm and when to use which.",c:"#fbbf24"},
          {i:"🗂️",l:"Database Sharding",d:"Horizontal partition data. Eliminates single-node limits but adds cross-shard query complexity.",c:"#f87171"},
          {i:"🌐",l:"CDN Strategy",d:"Push static assets to the edge. Dramatically reduces origin load and latency for global users.",c:"#818cf8"},
        ].map(c => (
          <div class="h-scroll-card" style={`border-top:2px solid ${c.c}55;width:240px;`}>
            <div style="font-size:20px;margin-bottom:10px;">{c.i}</div>
            <div style={`font-family:var(--font-heading);font-weight:700;font-size:13px;color:${c.c};margin-bottom:8px;`}>{c.l}</div>
            <p style="font-size:12px;color:rgba(238,238,248,0.38);line-height:1.65;">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DIVIDER ════════════════════════════════════════════════ -->
  <div style="max-width:1280px;margin:0 auto;padding:0 64px;"><div class="divline"></div></div>

  <!-- ═══ RESOURCES ══════════════════════════════════════════════ -->
  <section id="resources" style="position:relative;z-index:1;padding:100px 64px;max-width:1280px;margin:0 auto;" class="reveal">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;flex-wrap:wrap;gap:20px;">
      <div>
        <span class="section-tag">Go Deeper</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(36px,5vw,60px);font-weight:900;letter-spacing:-0.035em;margin-top:16px;line-height:1.0;">The reading list.</h2>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:32px;">
      {[
        {e:"📖",t:"Cracking the PM Interview",a:"McDowell & Bavaro",d:"The definitive PM prep playbook. Product design, estimation, and behavioral frameworks all in one place."},
        {e:"🎯",t:"Working Backwards",a:"Colin Bryar & Bill Carr",d:"Inside Amazon's PR/FAQ and 6-pager process. The closest thing to a manual for thinking like an Amazonian."},
        {e:"⚙️",t:"Designing Data-Intensive Apps",a:"Martin Kleppmann",d:"The bible of distributed systems. Required reading before any system design round at Amazon."},
        {e:"🚀",t:"The Lean Startup",a:"Eric Ries",d:"Build-Measure-Learn. How to think about MVPs, pivots, and validated learning — critical for product sense."},
        {e:"🧠",t:"Thinking in Bets",a:"Annie Duke",d:"Decision-making under uncertainty. Maps directly to Are Right, A Lot and Bias for Action."},
        {e:"🌊",t:"An Elegant Puzzle",a:"Will Larson",d:"Engineering management at scale — org design, migrations, team health. TPM mindset in one book."},
      ].map(book => (
        <div style="padding:26px 22px;background:rgba(255,255,255,0.018);border:1px solid rgba(255,255,255,0.06);border-radius:16px;transition:border-color 0.2s,background 0.2s,transform 0.2s;" onmouseover="this.style.borderColor='rgba(255,153,0,0.25)';this.style.background='rgba(255,153,0,0.03)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)';this.style.background='rgba(255,255,255,0.018)';this.style.transform='none'">
          <div style="font-size:26px;margin-bottom:14px;">{book.e}</div>
          <div style="font-family:var(--font-heading);font-weight:700;font-size:14px;color:#eeeef8;margin-bottom:4px;">{book.t}</div>
          <div style="font-size:10px;color:#FF9900;font-family:var(--font-heading);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:10px;">{book.a}</div>
          <p style="font-size:13px;color:rgba(238,238,248,0.4);line-height:1.65;">{book.d}</p>
        </div>
      ))}
    </div>

  </section>

  <!-- ═══ CTA ════════════════════════════════════════════════════ -->
  <section style="position:relative;z-index:1;padding:80px 64px 120px;max-width:1280px;margin:0 auto;">
    <div class="divline" style="margin-bottom:80px;"></div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:32px;">
      <div>
        <span class="section-tag">You&rsquo;re ready</span>
        <h2 style="font-family:var(--font-heading);font-size:clamp(36px,5vw,64px);font-weight:900;letter-spacing:-0.035em;margin-top:16px;line-height:1.0;">Start training.<br/><span style="color:rgba(238,238,248,0.3);font-weight:400;font-style:italic;font-size:0.75em;">Not rehearsing.</span></h2>
      </div>
      <PracticeModal client:only="react" />
    </div>
  </section>

  <!-- ═══ FOOTER ═════════════════════════════════════════════════ -->
  <footer style="position:relative;z-index:1;padding:24px 64px;border-top:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div style="display:flex;align-items:center;gap:8px;">
      <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><polygon points="9,1 16,5 16,13 9,17 2,13 2,5" stroke="#FF9900" stroke-width="1.2" fill="rgba(255,153,0,0.08)"/></svg>
      <span style="font-family:var(--font-heading);font-size:13px;color:rgba(238,238,248,0.25);">TPM Prep &mdash; Amazon interview prep</span>
    </div>
    <span style="font-family:var(--font-mono);font-size:11px;color:rgba(238,238,248,0.15);">Astro · React · Tailwind</span>
  </footer>
</BaseLayout>

<script>
  // Bento card → switch round tab
  document.querySelectorAll<HTMLElement>("[data-round-index]").forEach(card => {
    card.addEventListener("click", e => {
      e.preventDefault();
      const idx = parseInt(card.dataset.roundIndex ?? "0");
      window.dispatchEvent(new CustomEvent("roundchange", { detail: { index: idx } }));
    });
  });

  // Fold / show-more
  document.querySelectorAll<HTMLElement>(".foldable").forEach(container => {
    const show = parseInt(container.dataset.show ?? "3");
    const items = Array.from(container.querySelectorAll<HTMLElement>(".fold-item"));
    if (items.length <= show) return;

    // Hide items beyond threshold
    items.slice(show).forEach(el => { el.style.display = "none"; });

    // Find the next sibling button
    const btn = container.nextElementSibling as HTMLButtonElement | null;
    if (!btn || !btn.classList.contains("fold-toggle")) return;

    const hidden = items.length - show;
    btn.textContent = `Show ${hidden} more →`;

    let expanded = false;
    btn.addEventListener("click", () => {
      expanded = !expanded;
      items.slice(show).forEach(el => { el.style.display = expanded ? "" : "none"; });
      btn.textContent = expanded ? "Show less ↑" : `Show ${hidden} more →`;
    });
  });

  // Scroll reveal
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add("visible"); obs.unobserve(e.target); } }),
    { threshold: 0.05 }
  );
  revealEls.forEach(el => obs.observe(el));

  // Accordion chevron
  document.querySelectorAll<HTMLDetailsElement>("details").forEach(d => {
    d.addEventListener("toggle", () => {
      const chevron = d.querySelector<SVGElement>(".chevron");
      if (chevron) chevron.style.transform = d.open ? "rotate(180deg)" : "none";
    });
  });

  // Nav blur on scroll
  const nav = document.getElementById("nav");
  window.addEventListener("scroll", () => {
    if (!nav) return;
    const scrolled = window.scrollY > 40;
    nav.style.background = scrolled ? "rgba(6,6,10,0.85)" : "rgba(6,6,10,0)";
    nav.style.backdropFilter = scrolled ? "blur(24px) saturate(180%)" : "none";
    nav.style.borderBottomColor = scrolled ? "rgba(255,255,255,0.06)" : "rgba(255,255,255,0)";
  }, { passive: true });

  // 3D card tilt
  document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(card => {
    card.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const tX = (y - 0.5) * 10;
      const tY = (x - 0.5) * -10;
      card.style.transform = `perspective(1000px) rotateX(${tX}deg) rotateY(${tY}deg)`;
    });
    card.addEventListener("mouseleave", () => {
      card.style.transform = "perspective(1000px) rotateX(0) rotateY(0)";
      card.style.transition = "transform 0.5s cubic-bezier(0.22,1,0.36,1), box-shadow 0.25s";
    });
    card.addEventListener("mouseenter", () => {
      card.style.transition = "transform 0.1s ease, box-shadow 0.25s";
    });
  });
</script>
